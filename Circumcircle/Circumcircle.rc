#pragma code_page(65001)
#include "resource.h"
#include <afxres.h>

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT
IDD_CIRCUMCIRCLE_DIALOG DIALOGEX 0, 0, 720, 428
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_CLIPCHILDREN
CAPTION "3-Point Circumcircle"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT "클릭 지점 반지름", -1, 12, 15, 83, 12
    EDITTEXT IDC_POINT_RADIUS, 98, 12, 42, 17, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "px  (1~64)", -1, 145, 15, 58, 12
    LTEXT "정원 가장자리 두께", -1, 220, 15, 94, 12
    EDITTEXT IDC_CIRCLE_THICKNESS, 317, 12, 42, 17, ES_AUTOHSCROLL | WS_TABSTOP
    LTEXT "px  (1~32)", -1, 364, 15, 58, 12
    LTEXT "", IDC_VALIDATION, 12, 37, 535, 16
    CONTROL "", IDC_CANVAS, "Static", SS_NOTIFY | WS_BORDER, 12, 62, 540, 342
    LTEXT "세 점의 중심 좌표", -1, 568, 63, 140, 13
    LTEXT "Point 1 : -", IDC_POINT1, 568, 89, 140, 14
    LTEXT "Point 2 : -", IDC_POINT2, 568, 112, 140, 14
    LTEXT "Point 3 : -", IDC_POINT3, 568, 135, 140, 14
    LTEXT "왼쪽 위 = (0, 0), 단위: px", -1, 568, 160, 140, 25
    PUSHBUTTON "초기화", IDC_RESET, 568, 198, 140, 24
    PUSHBUTTON "랜덤 이동", IDC_RANDOM, 568, 230, 140, 24
    LTEXT "랜덤 이동 : 0 / 10", IDC_PROGRESS, 568, 267, 140, 15
    LTEXT "0.5초마다 이동 · 총 10회", -1, 568, 288, 140, 15
    LTEXT "", IDC_CIRCLE_INFO, 568, 320, 140, 46
    LTEXT "영역 안을 클릭해 점 3개를 만드세요.", IDC_STATUS, 12, 409, 696, 13
END
